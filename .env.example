OPEN_AI_KEY=
JWT_SECRET_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional — no API key needed. Defaults to Frankfurter's public API if unset.
FRANKFURTER_BASE_URL=

# Firebase Admin — push notification delivery. Set ONE of the two below;
# if neither is set, push notifications are disabled gracefully (no
# crash — sends just fail with PUSH_NOTIFICATION_UNAVAILABLE).
# Get this JSON from Firebase Console > Project settings > Service
# accounts > Generate new private key. NEVER commit the real value.
#
# Option A — the service account JSON as a single-line string (typical
# for platform "secret"/env-var style deployments):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","...":"..."}
FIREBASE_CREDENTIALS_JSON=

# Option B — a filesystem path to the downloaded service account JSON
# file instead (e.g. a secret mounted at deploy time). Do not commit
# the file this points to.
FIREBASE_CREDENTIALS_PATH=